{
  "expo": {
    "name": "Cleared",
    "slug": "Cleared",
    "scheme": "cleared",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ai_abdullah2026.Cleared"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
      "plugins": [
    "expo-router",
    [
      "expo-speech-recognition",
      {
        "microphonePermission": "Allow Cleared to use the microphone for voice typing."
      }
    ]
  ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-speech-recognition",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "cb628972-263e-4e30-b2c0-371e3b2748dd"
      }
    }
  }
}
