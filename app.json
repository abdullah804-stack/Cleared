{
  "expo": {
    "name": "Cleared",
    "slug": "Cleared",
    "scheme": "cleared",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.ai_abdullah2026.cleared",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0A2A44",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Cleared to use the microphone for voice typing."
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Cleared to add your dental appointments to your calendar."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Cleared to pick photos of your teeth for your progress gallery.",
          "cameraPermission": "Allow Cleared to take photos of your teeth for your progress gallery."
        }
      ],
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "cb628972-263e-4e30-b2c0-371e3b2748dd"
      }
    }
  }
}